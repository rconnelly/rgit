# Copied to /etc/rabun-git/rabun-git.env on bootstrap.
# push.sh --env FILE overwrites that path with a local dotenv file.
# Secrets (if any) stay here, not in /etc/rabun/rabun.env.

RABUN_GIT_CONFIG=/etc/rabun-git/rabun-git.toml
RABUN_GIT_ROOT=/var/lib/rabun-git

# SSH git + management commands (admin SSH on port 22 is unchanged)
# RABUN_GIT_SSH_BIND=0.0.0.0:2222

# Companion heartbeat (loopback GET /health; empty or off disables the bind)
# RABUN_GIT_HEALTH_BIND=127.0.0.1:8792
# RABUN_GIT_STATUS_FILE=/var/lib/rabun-git/status.json

# Logs (systemd captures stderr).
RUST_LOG=rabun_git=info
