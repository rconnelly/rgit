# Forge data root (bare repos, users, keys, ACL, run logs)
RABUN_GIT_ROOT=data/git

# SSH git + management commands (admin SSH on port 22 is unchanged)
# RABUN_GIT_SSH_BIND=0.0.0.0:2222

# Loopback companion health. Empty or `off` disables.
# RABUN_GIT_HEALTH_BIND=127.0.0.1:8792

# Optional status.json path (default: $RABUN_GIT_ROOT/status.json)
# RABUN_GIT_STATUS_FILE=
